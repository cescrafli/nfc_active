# =============================================================
# Salin file ini menjadi ".env" untuk pengembangan lokal.
# Di Netlify, isi nilai yang sama di:
#   Site configuration → Environment variables
# File .env TIDAK BOLEH di-commit (sudah ada di .gitignore).
# =============================================================

# Token rahasia untuk API admin (minimal 24 karakter).
# Buat token acak dengan:  npm run token
ADMIN_TOKEN=

# Google Maps API Key (WAJIB dibatasi HTTP referrer ke domain Netlify Anda).
# Ditulis otomatis ke public/config.js saat build. Kosongkan jika ingin input dari layar.
GOOGLE_MAPS_API_KEY=

# "off" = nonaktifkan mode Link Pengalih (hanya Link Langsung Google).
REDIRECT_MODE=on
